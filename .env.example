# =============================================================================
# Synthetic APAC Patient Face Dataset Generator – Environment Variables
# =============================================================================
#
# Copy this file to  backend/.env  and fill in real values.
# NEVER commit  backend/.env  to Git (it is already in .gitignore).
#
# Lines starting with # are comments.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Synthetic APAC Patient Face Dataset Generator
APP_VERSION=1.0.0
# Options: development | staging | production
ENVIRONMENT=development


# -----------------------------------------------------------------------------
# Database
# REQUIRED – application will not start without this.
# PostgreSQL connection string format:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/apac_face_db


# -----------------------------------------------------------------------------
# Storage directories
# Relative paths are resolved from the project root.
# Absolute paths are also accepted.
# -----------------------------------------------------------------------------
STORAGE_DIR=../storage
GENERATED_IMAGES_DIR=../storage/generated
ARTIFACT_DOWNLOAD_DIR=../storage/artifacts_tmp
VALIDATED_IMAGES_DIR=../storage/validated
REJECTED_IMAGES_DIR=../storage/rejected
EXPORT_DIR=../storage/exports


# -----------------------------------------------------------------------------
# Authentication
# CHANGE JWT_SECRET to a long random string before any deployment.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# -----------------------------------------------------------------------------
# Generation provider
#
# GENERATION_PROVIDER controls which backend generates images:
#   MOCK          – deterministic placeholder PNGs; no GPU required
#   KAGGLE_BATCH  – submits a Kaggle notebook run and retrieves outputs
#
# GENERATION_MODEL is a legacy alias kept for backward compatibility.
# GENERATION_PROVIDER takes precedence when both are set.
# -----------------------------------------------------------------------------
GENERATION_PROVIDER=MOCK
GENERATION_MODEL=MOCK

# Maximum images per dataset request.
MAX_REQUESTED_IMAGES=10000

# Default output dimensions in pixels.
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# Comma-separated list of allowed output formats (lowercase).
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,webp

# Maximum accepted file size per image (bytes). Default 20 MB.
MAX_IMAGE_FILE_BYTES=20971520

# Maximum generation attempts before a job is marked FAILED.
MAX_GENERATION_ATTEMPTS=100

# Number of images submitted to Kaggle per batch.
BATCH_SIZE=50


# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------
# How often (seconds) the worker polls the job queue.
WORKER_POLL_INTERVAL_SECONDS=10

# Seconds before an uncompleted job lease is considered stale.
JOB_LEASE_SECONDS=300

# Maximum job retries before marking the job FAILED permanently.
JOB_MAX_RETRIES=3


# -----------------------------------------------------------------------------
# Kaggle integration
# Required only when GENERATION_PROVIDER=KAGGLE_BATCH
#
# MANUAL ACTION REQUIRED:
#   1. Create a Kaggle account at https://www.kaggle.com
#   2. Go to https://www.kaggle.com/settings → API → Create New Token
#   3. The downloaded kaggle.json contains {"username":"...","key":"..."}.
#      Either:
#      a) Save it to  ~/.kaggle/kaggle.json  (standard location), OR
#      b) Set KAGGLE_USERNAME and KAGGLE_KEY directly in backend/.env
#         (recommended for server deployments where ~/.kaggle may be inaccessible)
#   4. Set KAGGLE_USERNAME, KAGGLE_KEY, and KAGGLE_KERNEL_SLUG below.
#
# IMPORTANT – Python environment:
#   The application MUST run from the project .venv (which has kaggle 1.7.x).
#   Running from the system Python with kaggle 2.x installed causes HTTP 401
#   errors during manifest upload.
#   Always start with:  .venv\Scripts\uvicorn backend.app.main:app --reload
#   Or use the provided start_app.cmd helper.
# -----------------------------------------------------------------------------

# Your Kaggle username (the part before the / in your profile URL).
KAGGLE_USERNAME=

# Your Kaggle API key (the "key" field from kaggle.json).
# Setting this here makes credentials available without requiring
# ~/.kaggle/kaggle.json to be accessible from the server process.
# Leave blank if you rely on the kaggle.json file instead.
KAGGLE_KEY=

# Full kernel slug: "username/kernel-slug" of your generation notebook.
# Example: myusername/apac-face-flux-generator
KAGGLE_KERNEL_SLUG=

# Slug of the private Kaggle dataset used to pass the manifest JSON
# to the notebook. Format: "username/dataset-slug".
# This dataset must be created once manually in the Kaggle web UI.
KAGGLE_MANIFEST_DATASET_SLUG=

# Path to the directory containing kaggle.json.
# Default is ~/.kaggle – only change if you store credentials elsewhere.
# KAGGLE_CONFIG_DIR=/home/user/.kaggle

# How often (seconds) the Kaggle adapter polls for notebook completion.
KAGGLE_POLL_INTERVAL_SECONDS=30

# Overall timeout (seconds) for a single Kaggle notebook run. Default 2 h.
KAGGLE_RUN_TIMEOUT_SECONDS=7200

# How many consecutive Kaggle poll errors before the job is failed.
KAGGLE_MAX_POLL_ERRORS=5


# -----------------------------------------------------------------------------
# Image validation pipeline
# -----------------------------------------------------------------------------
# Set to true to require face detection for every accepted image.
# Requires opencv-python to be installed.
REQUIRE_FACE_DETECTION=false

# Enable perceptual-hash duplicate detection.
ENABLE_DUPLICATE_DETECTION=true

# Maximum hash distance before two images are considered duplicates (0=identical).
DUPLICATE_HASH_THRESHOLD=10


# -----------------------------------------------------------------------------
# Export / retention
# -----------------------------------------------------------------------------
# Days to keep rejected images and temporary artifacts before cleanup.
ARTIFACT_RETENTION_DAYS=7
